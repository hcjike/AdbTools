<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- 显式列出源文件，避免把 payload_stage/bin/obj 等目录误包含 -->
    <EnableDefaultItems>false</EnableDefaultItems>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net46</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>AdbToolsInstaller</RootNamespace>
    <AssemblyName>AdbToolsInstaller</AssemblyName>
    <ProjectGuid>{A1B2C3D4-0000-0000-0000-0000000000A1}</ProjectGuid>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>appicon.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <!-- 保持与旧版一致的输出路径 bin\Debug / bin\Release（build_payload.ps1 依赖该路径） -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <!-- 强名称签名（与主程序共用同一密钥） -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\AdbTools.snk</AssemblyOriginatorKeyFile>
    <Company>宏尘</Company>
    <Copyright>Copyright © 宏尘 (www.hcjike.com)</Copyright>
  </PropertyGroup>
  <PropertyGroup>
    <!-- 生成前把主程序运行文件打包成 payload.zip，编译期作为资源嵌入，形成单文件 exe -->
    <PreBuildEvent>powershell -NoProfile -ExecutionPolicy Bypass -File "$(MSBuildThisFileDirectory)build_payload.ps1" -Configuration "$(Configuration)" -Version "$(Version)"</PreBuildEvent>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>
  <ItemGroup>
    <ApplicationDefinition Include="App.xaml" />
    <Page Include="MainWindow.xaml" />
    <Compile Include="App.xaml.cs" />
    <Compile Include="MainWindow.xaml.cs" />
    <Compile Include="InstallEngine.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- 主程序运行文件压缩包，编译期嵌入为资源（LogicalName 须与 InstallEngine 中读取名一致） -->
    <EmbeddedResource Include="payload.zip">
      <LogicalName>AdbToolsInstaller.Payload</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <None Include="app.manifest" />
    <!-- 作为 WPF Resource 嵌入，供 MainWindow 的 Icon="appicon.ico" 以 Pack URI 解析；
         exe 外壳图标由 <ApplicationIcon> 单独设置 -->
    <Resource Include="appicon.ico" />
    <None Include="build_payload.ps1" />
  </ItemGroup>
</Project>
