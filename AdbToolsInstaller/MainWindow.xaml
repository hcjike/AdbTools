<Window x:Class="AdbToolsInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adb连接工具 安装程序"
        Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei"
        Background="#F5F7FA"
        Icon="appicon.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题区 -->
        <Border Grid.Row="0" Background="#2F80ED">
            <StackPanel VerticalAlignment="Center" Margin="18,0">
                <TextBlock x:Name="HeaderTitle" Text="Adb连接工具 安装程序" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="HeaderSubtitle" Text="单文件安装 · 支持升级覆盖与卸载" FontSize="12" Foreground="#D6E4FF" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- 主体卡片 -->
        <Border Grid.Row="1" Background="White" Margin="8" CornerRadius="10" Padding="14,14,14,8">
            <StackPanel>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="13" Foreground="#374151" Margin="0,0,0,10"/>
                <Border x:Name="DeleteConfigPanel" Background="#EEF4FF" BorderBrush="#D6E4FF" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10" Visibility="Collapsed">
                    <CheckBox x:Name="DeleteConfigCheck" Content="同时删除用户配置" IsChecked="False"
                              FontSize="13" FontWeight="SemiBold" Foreground="#1F2937" VerticalContentAlignment="Center"/>
                </Border>
                <StackPanel x:Name="InstallPanel">
                    <TextBlock Text="安装目录" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PathBox" Grid.Column="0" Height="32" VerticalContentAlignment="Center" Padding="8,0" BorderBrush="#D1D5DB" BorderThickness="1"/>
                        <Button x:Name="BrowseButton" Grid.Column="1" Content="浏览" Width="72" Height="32" Margin="8,0,0,0" Click="Browse_Click" Style="{StaticResource GhostButton}"/>
                    </Grid>
                    <Border Background="#EEF4FF" BorderBrush="#D6E4FF" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                        <CheckBox x:Name="LaunchCheck" Content="安装完成后启动 Adb连接工具" IsChecked="True"
                                  FontSize="13" FontWeight="SemiBold" Foreground="#1F2937"
                                  VerticalContentAlignment="Center"/>
                    </Border>
                </StackPanel>
                <!-- 进度条、百分比与日志放在 InstallPanel 之外，安装与卸载两种模式都显示 -->
                <ProgressBar x:Name="Progress" Height="8" Foreground="#2F80ED" Background="#E5E7EB" Value="0" Margin="0,0,0,2"/>
                <TextBlock x:Name="PercentText" Text="" FontSize="11" Foreground="#6B7280" HorizontalAlignment="Right" Margin="0,2,0,8"/>
                <TextBox x:Name="LogBox" Height="116" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" Padding="8,6"/>
            </StackPanel>
        </Border>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,6,14,8">
            <Button x:Name="InstallButton" Content="安装" Width="120" Height="36" Margin="0,0,8,0" Click="Install_Click" Style="{StaticResource PrimaryButton}"/>
            <Button x:Name="UninstallButton" Content="卸载" Width="96" Height="36" Margin="0,0,8,0" Click="Uninstall_Click" Style="{StaticResource GhostButton}" Visibility="Collapsed"/>
            <Button x:Name="ExitButton" Content="退出" Width="96" Height="36" Click="Exit_Click" Style="{StaticResource GhostButton}"/>
        </StackPanel>
    </Grid>
</Window>
