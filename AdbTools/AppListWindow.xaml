<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="AdbTools.AppListWindow"
        xmlns:local="clr-namespace:AdbTools"
        Title="应用列表" Height="720" Width="1040" MinHeight="460" MinWidth="800"
        WindowStartupLocation="CenterScreen" Background="#FFF3F4F6" FontSize="13"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:RatioConverter x:Key="RatioConverter" />

        <!-- 行内操作按钮 -->
        <Style x:Key="RowButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource UserButtonStyle}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="13,5" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Background" Value="#FF2A9FFF" />
        </Style>

        <Style x:Key="ToggleButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource RowButtonStyle}">
            <Setter Property="Background" Value="#FFF59E0B" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                    <Setter Property="Background" Value="#FF10B981" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="UninstallButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource RowButtonStyle}">
            <Setter Property="Background" Value="#FFEF4444" />
        </Style>

        <Style x:Key="MoreButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource RowButtonStyle}">
            <Setter Property="Background" Value="#FFF1F3F7" />
            <Setter Property="Foreground" Value="#FF4B5563" />
        </Style>

        <!-- 左侧选择按钮：三个各自不同的颜色 -->
        <Style x:Key="SelectAllToolButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource RowButtonStyle}">
            <Setter Property="Background" Value="#FF0EA5E9" />
        </Style>

        <Style x:Key="InvertToolButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource RowButtonStyle}">
            <Setter Property="Background" Value="#FF7C3AED" />
        </Style>

        <Style x:Key="ClearSelectionToolButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource RowButtonStyle}">
            <Setter Property="Background" Value="#FF0D9488" />
        </Style>

        <!-- 右侧操作按钮：已有操作复用行内风格，其余按语义定义 -->
        <Style x:Key="EnableToolButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource RowButtonStyle}">
            <Setter Property="Background" Value="#FF10B981" />
        </Style>

        <Style x:Key="ClearDataToolButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource RowButtonStyle}">
            <Setter Property="Background" Value="#FFF97316" />
        </Style>

        <Style x:Key="ResolveToolButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource RowButtonStyle}">
            <Setter Property="Background" Value="#FF4F46E5" />
        </Style>

        <Style x:Key="ForceStopToolButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource RowButtonStyle}">
            <Setter Property="Background" Value="#FFDB2777" />
        </Style>

        <!-- 列表行：白底卡片，悬停变浅蓝，去掉默认选中底色 -->
        <Style x:Key="AppItemStyle" TargetType="{x:Type ListBoxItem}">
            <EventSetter Event="PreviewMouseLeftButtonDown"
                         Handler="AppItem_PreviewMouseLeftButtonDown" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="card" Background="White" CornerRadius="10"
                                BorderBrush="#FFE5E7EB" BorderThickness="1" Padding="14,10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="card" Property="Background" Value="#FFF9FBFE" />
                                <Setter TargetName="card" Property="BorderBrush" Value="#FFBFD8FF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="card" Property="BorderBrush" Value="#FF2A9FFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#FFE5E7EB" BorderThickness="1" CornerRadius="10" Padding="12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <TextBox x:Name="searchBox" Height="32" Style="{StaticResource UserTextBox}"
                                 TextChanged="SearchBox_TextChanged" />
                        <TextBlock x:Name="searchHint" Text="搜索应用名或包名" Foreground="#FF9CA3AF"
                                   Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>

                    <ComboBox x:Name="filterBox" Grid.Column="1" Width="150" Height="32" Margin="10,0,0,0"
                              Style="{StaticResource UserComboBox}" SelectedIndex="0"
                              SelectionChanged="FilterBox_SelectionChanged">
                        <ComboBoxItem Content="全部应用" Tag="0" />
                        <ComboBoxItem Content="第三方应用" Tag="1" />
                        <ComboBoxItem Content="系统应用" Tag="2" />
                        <ComboBoxItem Content="系统服务" Tag="4" />
                        <ComboBoxItem Content="已停用应用" Tag="3" />
                        <ComboBoxItem Content="已卸载应用" Tag="5" />
                        <ComboBoxItem Content="Debug 应用" Tag="6" />
                        <ComboBoxItem Content="非 Debug 应用" Tag="7" />
                    </ComboBox>

                    <Button x:Name="refreshButton" Grid.Column="2" Content="刷新" Height="32" Margin="10,0,0,0"
                            Style="{StaticResource RowButtonStyle}" Click="Refresh_Click"
                            ToolTip="重新读取设备上的应用列表" />
                </Grid>

                <Grid Margin="0,10,0,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                HorizontalAlignment="Left">
                        <StackPanel x:Name="selectionButtonPanel" Orientation="Horizontal">
                            <Button x:Name="selectAllButton" Content="全选"
                                    Style="{StaticResource SelectAllToolButtonStyle}"
                                    FontSize="12" Padding="10,4" Click="SelectAll_Click"
                                    ToolTip="全选 / 取消全选当前筛选结果" />
                            <Button Content="反选" Style="{StaticResource InvertToolButtonStyle}"
                                    FontSize="12" Padding="10,4" Click="InvertSelection_Click"
                                    ToolTip="反转当前筛选结果的选择状态" />
                        </StackPanel>
                        <TextBlock x:Name="selectionText" Text="已选 0 项" Foreground="#FF6B7280"
                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                        <StackPanel x:Name="batchButtonPanel" Orientation="Horizontal">
                            <Button Content="停用" Style="{StaticResource ToggleButtonStyle}"
                                    FontSize="12" Padding="10,4" Click="BatchDisable_Click"
                                    ToolTip="停用选中应用：保留数据，可随时启用" />
                            <Button Content="启用" Style="{StaticResource EnableToolButtonStyle}"
                                    FontSize="12" Padding="10,4" Click="BatchEnable_Click"
                                    ToolTip="启用选中应用：恢复正常使用" />
                            <TextBlock Text="|" Foreground="#FFE5E7EB" Margin="8,0,2,0"
                                    VerticalAlignment="Center" />
                            <Button Content="卸载" Style="{StaticResource UninstallButtonStyle}"
                                    FontSize="12" Padding="10,4" Click="BatchUninstall_Click"
                                    ToolTip="卸载选中应用并删除数据" />
                            <TextBlock Text="|" Foreground="#FFE5E7EB" Margin="8,0,2,0"
                                    VerticalAlignment="Center" />
                            <Button Content="清除数据" Style="{StaticResource ClearDataToolButtonStyle}"
                                    FontSize="12" Padding="10,4" Click="BatchClearData_Click"
                                    ToolTip="清除选中应用的账号、设置与缓存，不可撤销" />
                            <Button Content="强制停止" Style="{StaticResource ForceStopToolButtonStyle}"
                                    FontSize="12" Padding="10,4" Click="BatchForceStop_Click"
                                    ToolTip="结束选中应用的进程，不会删除数据" />
                            <TextBlock Text="|" Foreground="#FFE5E7EB" Margin="8,0,2,0"
                                    VerticalAlignment="Center" />
                            <Button Content="解析应用" Style="{StaticResource ResolveToolButtonStyle}"
                                    FontSize="12" Padding="10,4" Click="BatchReResolve_Click"
                                    ToolTip="从设备重新解析选中应用的名称、图标与版本" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 应用列表 -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <ListBox x:Name="appList" Background="Transparent" BorderThickness="0"
                     SelectionMode="Extended" SelectionChanged="AppList_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     ItemContainerStyle="{StaticResource AppItemStyle}" av:ItemsSource="{av:SampleData ItemCount=5}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Height="34"
                                              Checked="Selection_Changed" Unchecked="Selection_Changed"
                                              Click="SelectionCheckBox_Click"
                                              VerticalAlignment="Center" Margin="0,0,10,0"
                                              ToolTip="选择此应用" />

                                    <!-- 图标：取不到时用包名首字母 + 固定色块占位 -->
                                    <Border Width="34" Height="34" CornerRadius="9" Background="{Binding IconBackground}"
                                            VerticalAlignment="Center" Margin="0,0,10,0">
                                        <Grid>
                                            <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="15"
                                                       FontWeight="SemiBold" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding NoIcon, Converter={StaticResource BoolToVis}}" />
                                            <Image Source="{Binding Icon}" Stretch="Uniform"
                                                   Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Grid x:Name="titleRow">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="#FF111827" VerticalAlignment="Center"
                                                   MaxWidth="{Binding ActualWidth, ElementName=titleRow,
                                                                Converter={StaticResource RatioConverter},
                                                                ConverterParameter=0.49}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"
                                                   ToolTipService.ShowDuration="8000" />
                                        <ScrollViewer Grid.Column="1" Margin="8,0,0,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalScrollBarVisibility="Hidden"
                                                      VerticalScrollBarVisibility="Disabled"
                                                      Loaded="BadgeScroller_Loaded"
                                                      MouseMove="BadgeScroller_MouseMove"
                                                      MouseLeftButtonUp="BadgeScroller_MouseUp"
                                                      LostMouseCapture="BadgeScroller_LostMouseCapture">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Margin="0,0,0,0" CornerRadius="8" Padding="7,1"
                                            Background="#FFF1F5F9" VerticalAlignment="Center"
                                            Visibility="{Binding FromCache, Converter={StaticResource BoolToVis}}">
                                                    <Border.ToolTip>
                                                        <TextBlock MaxWidth="300" TextWrapping="Wrap" FontSize="12"><Bold><Run Text="缓存"/></Bold><LineBreak/><Run Text="该行信息来自本地缓存，本次未重新读取设备资源。"/><LineBreak/><Run Text="判断：应用名之前已解析过并缓存，本次直接复用。"/></TextBlock>
                                                    </Border.ToolTip>
                                                    <TextBlock Text="缓存" FontSize="11" Foreground="#FF64748B" />
                                                </Border>
                                                <Border Margin="8,0,0,0" CornerRadius="8" Padding="7,1"
                                            Background="#FFEFF6FF" VerticalAlignment="Center">
                                                    <Border.ToolTip>
                                                        <TextBlock MaxWidth="300" TextWrapping="Wrap" FontSize="12"><Bold><Run Text="应用归属类型"/></Bold><LineBreak/><Run Text="“系统”=预装于系统分区，“第三方”=用户自行安装。"/><LineBreak/><Run Text="判断：安装位置在系统分区（/system、/vendor、/product 等）为“系统”，否则为“第三方”。"/></TextBlock>
                                                    </Border.ToolTip>
                                                    <TextBlock Text="{Binding TypeText}" FontSize="11" Foreground="#FF2A9FFF" />
                                                </Border>
                                                <Border Margin="6,0,0,0" CornerRadius="8" Padding="7,1"
                                            Background="#F3E8FF" VerticalAlignment="Center"
                                            ToolTipService.ShowDuration="8000"
                                            Visibility="{Binding HasVersion, Converter={StaticResource BoolToVis}}">
                                                    <Border.ToolTip>
                                                        <TextBlock MaxWidth="300" TextWrapping="Wrap" FontSize="12"><Bold><Run Text="版本号"/></Bold><LineBreak/><Run Text="从 APK 的 AndroidManifest 读取 versionName，结果缓存在本地数据库。"/></TextBlock>
                                                    </Border.ToolTip>
                                                    <TextBlock Text="{Binding VersionText, Mode=OneWay}" FontSize="11"
                                                       Foreground="#FF7C3AED" MaxWidth="160"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                </Border>
                                                <Border Margin="6,0,0,0" CornerRadius="8" Padding="7,1"
                                            Background="#FFFFF3E0" VerticalAlignment="Center"
                                            Visibility="{Binding IsService, Converter={StaticResource BoolToVis}}">
                                                    <Border.ToolTip>
                                                        <TextBlock MaxWidth="300" TextWrapping="Wrap" FontSize="12"><Bold><Run Text="系统服务"/></Bold><LineBreak/><Run Text="系统应用里无桌面图标或常驻运行的后台服务型应用，停用/卸载风险较高。"/><LineBreak/><Run Text="判断：无桌面图标入口，或声明为常驻运行（persistent）。"/></TextBlock>
                                                    </Border.ToolTip>
                                                    <TextBlock Text="系统服务" FontSize="11" Foreground="#FFB45309" />
                                                </Border>
                                                <Border Margin="6,0,0,0" CornerRadius="8" Padding="7,1"
                                            Background="#FFECFDF5" VerticalAlignment="Center"
                                            Visibility="{Binding IsDebug, Converter={StaticResource BoolToVis}}">
                                                    <Border.ToolTip>
                                                        <TextBlock MaxWidth="300" TextWrapping="Wrap" FontSize="12"><Bold><Run Text="Debug 应用"/></Bold><LineBreak/><Run Text="APK 的 AndroidManifest 里声明了 android:debuggable=&quot;true&quot;。"/><LineBreak/><Run Text="判断：dumpsys package 输出中该包的 flags 含 DEBUGGABLE；每次刷新重新读取，不使用缓存。"/></TextBlock>
                                                    </Border.ToolTip>
                                                    <TextBlock Text="Debug" FontSize="11" Foreground="#FF059669" />
                                                </Border>
                                                <Border Margin="6,0,0,0" CornerRadius="8" Padding="7,1"
                                            Background="{Binding StatusBackground}" VerticalAlignment="Center">
                                                    <Border.ToolTip>
                                                        <TextBlock MaxWidth="300" TextWrapping="Wrap" FontSize="12"><Bold><Run Text="启用状态"/></Bold><LineBreak/><Run Text="“已停用”=应用被停用（冻结），“已启用”=正常可用。"/><LineBreak/><Run Text="判断：该应用当前是否处于停用状态。"/></TextBlock>
                                                    </Border.ToolTip>
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                   Foreground="{Binding StatusForeground}" />
                                                </Border>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>
                                    <TextBlock Text="{Binding PackageName}" FontSize="11.5" Foreground="#FF8A94A6"
                                           Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Grid.Column="1" Text="处理中…" Foreground="#FF9CA3AF" FontSize="12"
                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                <Button Content="{Binding ActionText}" Style="{StaticResource ToggleButtonStyle}"
                                        IsEnabled="{Binding IsNotBusy}" Click="ToggleApp_Click" />
                                <Button Content="卸载" Style="{StaticResource UninstallButtonStyle}"
                                        IsEnabled="{Binding IsNotBusy}" Click="UninstallApp_Click"
                                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}" />
                                <Button Content="更多" Style="{StaticResource MoreButtonStyle}"
                                        IsEnabled="{Binding IsNotBusy}" Click="More_Click" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 操作结果提示：默认隐藏，操作后显示最多 5 秒 -->
            <Border x:Name="actionTip" Visibility="Collapsed" HorizontalAlignment="Center"
                    VerticalAlignment="Bottom" Margin="0,0,0,12" MaxWidth="760"
                    Background="#E60F172A" CornerRadius="8" Padding="14,7"
                    IsHitTestVisible="False" Panel.ZIndex="2">
                <TextBlock x:Name="actionTipText" Foreground="White" FontSize="12.5"
                           TextWrapping="Wrap" TextAlignment="Center" />
            </Border>

            <TextBlock x:Name="emptyHint" Text="没有符合条件的应用" Foreground="#FF9CA3AF"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />

            <Border x:Name="loadingMask" Background="#E6F3F4F6" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4" BorderThickness="0"
                                 Foreground="#FF2A9FFF" Background="#FFE5E7EB" />
                    <TextBlock x:Name="loadingText" Text="正在读取应用列表…" Foreground="#FF6B7280"
                               Margin="0,12,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 状态栏 -->
        <Grid Grid.Row="2" Margin="4,10,4,0">
            <TextBlock x:Name="statusText" Foreground="#FF6B7280" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Margin="0,0,220,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="progressText" Foreground="#FF9CA3AF" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button x:Name="stopBatchButton" Content="停止操作" FontSize="11" Padding="10,3"
                        Style="{StaticResource MoreButtonStyle}" Visibility="Collapsed" Click="StopBatch_Click" />
                <Button x:Name="stopResolveButton" Content="停止获取名称" FontSize="11" Padding="10,3"
                        Style="{StaticResource MoreButtonStyle}" Visibility="Collapsed" Click="StopResolve_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
