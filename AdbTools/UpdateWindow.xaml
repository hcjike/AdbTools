<Window x:Class="AdbTools.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdbTools"
        mc:Ignorable="d"
        Title="软件更新" Width="360" SizeToContent="Height" FontSize="14"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="0">
        <Border Background="White" BorderBrush="#FFE5E7EB" BorderThickness="0" Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#FF1F2937" Opacity="0.12"/>
            </Border.Effect>
            <StackPanel>
                <!-- 版本号放在内容区居中显示，标题栏只表示窗口用途（避免标题栏过长被截断） -->
                <TextBlock x:Name="titleText" FontSize="16" FontWeight="SemiBold" Foreground="Black" TextWrapping="Wrap" TextAlignment="Center"/>
                <!-- 说明文字中的「更新说明 ↗」为异色可点击链接，点击用浏览器打开，窗口不关闭 -->
                <TextBlock x:Name="detailText" Margin="0,10,0,22" Foreground="Black" TextWrapping="Wrap" LineHeight="21" TextAlignment="Center">
                    <Run Text="是否立即下载并安装？"/><LineBreak/>
                    <Run Text="本次改动已整理好，点击"/>
                    <Hyperlink x:Name="releaseLink" Click="releaseLink_Click" Foreground="#FF2A9FFF" Cursor="Hand">更新说明 ↗</Hyperlink>
                    <Run Text="快速了解。"/>
                </TextBlock>
                <!-- 按键平分内容区宽度并居中：主操作「立即更新」在左，次要操作「以后再说」在右，点击区域更大 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="updateButton" Grid.Column="0" Content="立即更新" Height="34" Margin="0,0,5,0" Foreground="White" Background="#FF2A9FFF" Cursor="Hand" IsDefault="True" Click="update_Click"/>
                    <Button x:Name="cancelButton" Grid.Column="1" Content="以后再说" Height="34" Margin="5,0,0,0" Foreground="Black" BorderBrush="{x:Null}" Background="#FFE5E7EB" Cursor="Hand" IsCancel="True" Click="cancel_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
