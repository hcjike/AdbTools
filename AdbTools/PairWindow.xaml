<Window x:Class="AdbTools.PairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdbTools" xmlns:customcontrol="clr-namespace:AdbTools.CustomControl"
        mc:Ignorable="d"
        Title="使用配对码配对设备" Width="360" SizeToContent="Height" FontSize="14" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Grid>
        <Grid Margin="0">
            <Border Background="White" CornerRadius="0" BorderBrush="#FFE5E7EB" BorderThickness="0" Padding="16,16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#FF1F2937" Opacity="0.12"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- 配对地址 -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="配对地址" FontSize="12" Foreground="Black" Margin="2,0,0,4"/>
                        <TextBox x:Name="deviceAddress" Style="{StaticResource UserTextBox}" ToolTip="示例：192.168.0.1:5555，使用英文【:】连接IP和端口" Height="36" TabIndex="0" HorizontalContentAlignment="Center"/>
                    </StackPanel>
                    <!-- 配对码 -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,14">
                        <TextBlock Text="配对码" FontSize="12" Foreground="Black" Margin="2,0,0,4"/>
                        <TextBox x:Name="pairCode" Style="{StaticResource UserTextBox}" ToolTip="输入配对码" Height="36" MaxLength="10" TabIndex="1" HorizontalContentAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Row="2" x:Name="pairDevice" IsDefault="True" Content="配对 (Enter)" ToolTip="输入配对的IP端口和配对码进行配对" Foreground="White" Background="#FF2A9FFF" Height="34" Width="120" Cursor="Hand" TabIndex="2" Click="pairDevice_Click" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <Grid Visibility="Collapsed" x:Name="processBarGrid" Background="#7F000000" >
            <customcontrol:RoundProcessBarLoading x:Name="waitProcessBar" Height="130" Width="130"/>
            <Label Content="处理中"  Height="120" Width="120" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Foreground="White"/>
        </Grid>
    </Grid>
</Window>
