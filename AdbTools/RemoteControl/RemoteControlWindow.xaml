<Window x:Class="AdbTools.RemoteControl.RemoteControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:ClassModifier="internal"
        Title="远程控制"
        Width="500" Height="880" MinWidth="320" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Closed="Window_Closed"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseWheel="RemoteScreen_PreviewMouseWheel">
    <!-- 背景用中心稍亮的径向渐变，让深色机身有明确轮廓，不再和背景糊在一起 -->
    <Window.Background>
        <RadialGradientBrush Center="0.5,0.42" GradientOrigin="0.5,0.42" RadiusX="0.78" RadiusY="0.78">
            <GradientStop Color="#FF262631" Offset="0" />
            <GradientStop Color="#FF09090C" Offset="1" />
        </RadialGradientBrush>
    </Window.Background>
    <Window.Resources>
        <!-- 分辨率下拉框的深色模板：扁平圆角、自绘箭头，与远程控制窗口配色一致 -->
        <ControlTemplate x:Key="ResolutionComboTemplate" TargetType="ComboBox">
            <Grid>
                <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                              Foreground="#FFF2F2F2" FontSize="12"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="bd" Background="#FF23232A" BorderBrush="#FF3F3F46"
                                    BorderThickness="1" CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" Margin="8,0,4,0"
                                                      VerticalAlignment="Center" HorizontalAlignment="Left" />
                                    <Path Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center"
                                          Data="M0,0 L8,0 L4,5 Z" Fill="#FFB9B9C2" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#FF5C5C68" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="2"
                       IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                       Focusable="False" PopupAnimation="Fade">
                    <Border Background="#FF23232A" BorderBrush="#FF3F3F46" BorderThickness="1"
                            CornerRadius="4" Padding="2" MinWidth="132">
                        <ItemsPresenter />
                    </Border>
                </Popup>
            </Grid>
        </ControlTemplate>

        <!-- 下拉项内容：清晰度图标 + 档位名称（图标几何由多个 Path 共用） -->
        <DataTemplate x:Key="ResolutionItemTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,1">
                <Path Data="{Binding Icon}" Width="14" Height="14" Margin="1,0,7,0"
                      Stretch="Uniform" Stroke="#FFF2F2F2" StrokeThickness="1.5" Fill="Transparent"
                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" Foreground="#FFF2F2F2" FontSize="12"
                           VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <!-- 下拉项样式：深色底、白字，悬停浅灰、选中蓝色，悬停显示该档位的说明 -->
        <Style x:Key="ResolutionComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#FFF2F2F2" />
            <!-- 鼠标移到项上变小手，与窗口里其他可点控件保持一致 -->
            <Setter Property="Cursor" Value="Hand" />
            <!-- 提示文字较长，延长显示时间；ToolTip 内容由档位数据的 Tip 提供 -->
            <Setter Property="ToolTip" Value="{Binding Tip}" />
            <Setter Property="ToolTipService.ShowDuration" Value="20000" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="300" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="3" Padding="8,4" Margin="0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF33333C" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF2A9FFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 导航按键外观：深灰圆角，鼠标悬停变亮，按下变蓝（与主界面按钮色调一致） -->
        <ControlTemplate x:Key="NavButtonTemplate" TargetType="Button">
            <Border x:Name="bd" Background="#FF35353D" CornerRadius="5" SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="#FF4C4C58" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="#FF2A9FFF" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- 导航按键通用尺寸与光标，模板引用上面的 NavButtonTemplate -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <!-- 左右各留 3，按键间距 6，整体居中时左右留白对称 -->
            <Setter Property="Margin" Value="3,0,3,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template" Value="{StaticResource NavButtonTemplate}" />
        </Style>

        <!-- 顶部状态文字：单行显示，过长时省略，保证顶部栏高度稳定、与下拉框对齐 -->
        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,8,0" />
        </Style>

        <!-- 仿手机外框：金属渐变机身 + 高光边框 + 厚内边距 -->
        <Style x:Key="PhoneFrameStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="30" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF3A3A46" Offset="0" />
                        <GradientStop Color="#FF1C1C22" Offset="0.45" />
                        <GradientStop Color="#FF0C0C10" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFB2B2C2" Offset="0" />
                        <GradientStop Color="#FF4E4E5A" Offset="0.32" />
                        <GradientStop Color="#FF232329" Offset="0.66" />
                        <GradientStop Color="#FF848492" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 画面中央卡片：启动过程、锁屏/息屏、异常说明共用一套样式 -->
        <Style x:Key="StartupPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#EE1A1A22" />
            <Setter Property="BorderBrush" Value="#FF3F3F46" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="26,20" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MaxWidth" Value="360" />
        </Style>

        <!-- 状态栏小工具按钮（例如 1:1）：深色圆角，悬停提亮 -->
        <Style x:Key="ToolIconButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#FFF2F2F2" />
            <Setter Property="Background" Value="#FF2A2A33" />
            <Setter Property="BorderBrush" Value="#FF3F3F46" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bg" CornerRadius="4" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#FF3A3A45" />
                            </Trigger>
                            <!-- 截屏执行期间按钮禁用：给出明确的"正在处理"视觉，而不是看起来没反应 -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            录制按钮专用样式：模板不再在悬停时替换背景色。
            通用工具按钮悬停会把底色换成灰色，而录制中底色是红色（表示正在录制），
            被盖成灰色后按钮状态与图标都看不清，所以这里只提亮描边 + 轻微压暗。
        -->
        <Style x:Key="RecordButtonStyle" TargetType="{x:Type Button}"
               BasedOn="{StaticResource ToolIconButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bg" CornerRadius="4" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 悬停只提亮描边：录制中的红底与白色停止图标保持原样，不会因为悬停变灰/变暗 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="#FF8A8A98" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <!-- 保存录像期间按钮禁用：变暗表示"正在处理"，避免看起来没反应 -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 四行：状态栏 / 手机外框（占满剩余空间）/ 虚拟按键栏 / 隐藏输入框 -->
    <Grid x:Name="_root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：左侧只显示帧率，右侧是截屏 / 录制 / 1:1 与分辨率菜单。
             上下留白让这一栏与窗口边缘、画面区分开，不显得贴在一起 -->
        <Grid x:Name="_topBar" Grid.Row="0" Height="28" Margin="6,2,6,2" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- 与运行时格式一致（只有帧率，分辨率映射在悬停提示里），避免首帧前闪一下别的文案 -->
            <TextBlock x:Name="_status" Grid.Column="0" Text="0 fps"
                       Style="{StaticResource StatusTextStyle}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="8,0,0,0">
                <!-- 截屏：走设备端 screencap，按设备原始分辨率保存 PNG（与采集档位无关） -->
                <Button x:Name="_shotButton" Width="30" Height="22"
                        Margin="0,0,6,0" Style="{StaticResource ToolIconButtonStyle}"
                        UseLayoutRounding="True" SnapsToDevicePixels="True"
                        Click="Screenshot_Click"
                        ToolTip="截屏（设备原始分辨率 PNG）">
                    <!-- 16x16 与 30x22（含 1px 边框）配对：(28-16)/2=6、(20-16)/2=2，都是整数，避免半像素偏移 -->
                    <Viewbox Width="16" Height="16" Stretch="Uniform"
                             HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="24" Height="24">
                            <!-- 取景角标：与 Android Studio 一致的四个直角框 -->
                            <Path Data="M3.2,8 L3.2,3.2 L8,3.2 M16,3.2 L20.8,3.2 L20.8,8 M20.8,16 L20.8,20.8 L16,20.8 M8,20.8 L3.2,20.8 L3.2,16"
                                  Stroke="#FFF2F2F2" StrokeThickness="1.7" Fill="Transparent"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <!-- 相机机身（严格居中，不留偏移量） -->
                            <Rectangle Width="11.2" Height="7.8" RadiusX="1.4" RadiusY="1.4"
                                       Stroke="#FFF2F2F2" StrokeThickness="1.5" Fill="Transparent"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <!-- 镜头 -->
                            <Ellipse Width="3.3" Height="3.3" Stroke="#FFF2F2F2" StrokeThickness="1.5"
                                     Fill="Transparent"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Viewbox>
                </Button>

                <!-- 录制：直接存远程画面码流（不重编码），分辨率跟随采集档位。
                     未录制显示圆点，录制中显示方块（停止），由代码切换可见性 -->
                <Button x:Name="_recordButton" Width="30" Height="22"
                        Margin="0,0,6,0" Style="{StaticResource RecordButtonStyle}"
                        UseLayoutRounding="True" SnapsToDevicePixels="True"
                        Click="Record_Click"
                        ToolTip="录制画面（分辨率跟随当前档位）">
                    <Viewbox Width="16" Height="16" Stretch="Uniform"
                             HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="24" Height="24">
                            <!-- 取景角标：与截屏图标同一套语言，录制态也保留 -->
                            <Path Data="M3.2,8 L3.2,3.2 L8,3.2 M16,3.2 L20.8,3.2 L20.8,8 M20.8,16 L20.8,20.8 L16,20.8 M8,20.8 L3.2,20.8 L3.2,16"
                                  Stroke="#FFF2F2F2" StrokeThickness="1.7" Fill="Transparent"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <!-- 未录制：红色圆环（沿用 Android Studio 的录屏语义），视觉直径与停止方块接近 -->
                            <Ellipse x:Name="_recordIdleIcon" Width="9" Height="9"
                                     Stroke="#FFE0443E" StrokeThickness="2.2" Fill="Transparent"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <!-- 录制中：纯白实心方块，表示“停止”（此时按钮底色为红，保证高对比） -->
                            <Rectangle x:Name="_recordStopIcon" Width="8" Height="8" RadiusX="1.2" RadiusY="1.2"
                                       Fill="#FFFFFFFF" Visibility="Collapsed"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Viewbox>
                </Button>

                <!-- 按画面像素调整窗口：画面 1 个像素 = 屏幕 1 个像素 -->
                <Button x:Name="_pixelFitButton" Content="1:1" Width="36" Height="22"
                        Margin="0,0,6,0" Style="{StaticResource ToolIconButtonStyle}"
                        Click="PixelFit_Click"
                        ToolTip="按画面像素调整窗口大小（1:1 显示）" />
                <ComboBox x:Name="_resolutionBox"
                          Width="132" Height="22"
                          VerticalAlignment="Center" Foreground="White" Cursor="Hand"
                          FocusVisualStyle="{x:Null}"
                          ToolTip="采集分辨率"
                          Template="{StaticResource ResolutionComboTemplate}"
                          ItemTemplate="{StaticResource ResolutionItemTemplate}"
                          ItemContainerStyle="{StaticResource ResolutionComboItemStyle}" />
            </StackPanel>
        </Grid>

        <!-- 画面：等比填充在手机外框内部，外框尺寸随窗口缩放同步调整 -->
        <Grid x:Name="_screenHost" Grid.Row="1" SizeChanged="RemoteScreen_SizeChanged">
            <!-- 阴影单独放在空 Border 上：避免对含视频的画面子树应用 Effect，
                 否则每帧都要先渲染到离屏表面，5MP 画面下开销很大 -->
            <Border Background="#FF0B0B0F" CornerRadius="36"
                    Width="{Binding ActualWidth, ElementName=_phoneFrame}"
                    Height="{Binding ActualHeight, ElementName=_phoneFrame}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="36" ShadowDepth="10" Direction="270"
                                      Color="#FF000000" Opacity="0.9" />
                </Border.Effect>
            </Border>

            <Border x:Name="_phoneFrame" Style="{StaticResource PhoneFrameStyle}">
                <Image x:Name="_image" Stretch="Uniform"
                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                       RenderOptions.BitmapScalingMode="LowQuality"
                       SizeChanged="Image_SizeChanged"
                       MouseLeftButtonDown="Image_MouseLeftButtonDown"
                       MouseMove="Image_MouseMove"
                       MouseLeftButtonUp="Image_MouseLeftButtonUp" />
            </Border>

            <!-- 画面中央卡片：启动过程、锁屏/息屏、异常说明都在这里，
                 只显示简化的阶段文案，不把 scrcpy/adb 的详细日志刷到画面上 -->
            <Border x:Name="_startupPanel" Style="{StaticResource StartupPanelStyle}">
                <StackPanel>
                    <TextBlock x:Name="_startupTitle" Text="正在连接设备"
                               Foreground="#FFF2F2F2" FontSize="16" FontWeight="SemiBold"
                               TextAlignment="Center" />
                    <TextBlock x:Name="_startupSteps"
                               Foreground="#FF9CA3AF" FontSize="12" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <!-- 操作提示浮层：短暂提示，5 秒后自动隐藏，不参与启动/息屏卡片的状态判断。
                 带产物路径时（截图/录像完成）可点击打开所在文件夹，这时才参与命中测试，
                 避免平时挡住画面上的点击注入 -->
            <Border x:Name="_toast" Background="#EE1A1A22" BorderBrush="#FF3F3F46" BorderThickness="1"
                    CornerRadius="8" Padding="14,8" Margin="0,0,0,16"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Visibility="Collapsed" IsHitTestVisible="False"
                    MouseLeftButtonUp="Toast_Click">
                <StackPanel>
                    <TextBlock x:Name="_toastText" Foreground="#FFF2F2F2" FontSize="12.5"
                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
                    <TextBlock x:Name="_toastAction" Text="点击打开所在文件夹"
                               Foreground="#FF6EA8FF" FontSize="12" TextAlignment="Center"
                               Margin="0,4,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 虚拟按键：小尺寸、在窗口下方居中摆放。
             Tag 约定：keyCode[:repeat][:longpress]，由后台统一处理注入与按住行为 -->
        <StackPanel x:Name="_navBar" Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6,0,8">
            <!-- 返回（keyevent 4） -->
            <Button Style="{StaticResource NavButtonStyle}" Tag="4" ToolTip="返回（keyevent 4）"
                    Click="NavButton_Click">
                <Viewbox Width="13" Height="13" Stretch="Uniform">
                    <Path Data="M15,2 L3,12 L15,22 Z" Stroke="#FFF2F2F2" StrokeThickness="2"
                          StrokeLineJoin="Round" Fill="Transparent"
                          Width="18" Height="24" Stretch="Uniform" />
                </Viewbox>
            </Button>

            <!-- Home（keyevent 3） -->
            <Button Style="{StaticResource NavButtonStyle}" Tag="3" ToolTip="Home（keyevent 3）"
                    Click="NavButton_Click">
                <Viewbox Width="13" Height="13" Stretch="Uniform">
                    <Ellipse Width="18" Height="18" Stroke="#FFF2F2F2" StrokeThickness="2"
                             Fill="Transparent" />
                </Viewbox>
            </Button>

            <!-- 任务（keyevent 187） -->
            <Button Style="{StaticResource NavButtonStyle}" Tag="187" ToolTip="任务（keyevent 187）"
                    Click="NavButton_Click">
                <Viewbox Width="13" Height="13" Stretch="Uniform">
                    <Rectangle Width="18" Height="18" RadiusX="2" RadiusY="2"
                               Stroke="#FFF2F2F2" StrokeThickness="2" Fill="Transparent" />
                </Viewbox>
            </Button>

            <!-- 分隔线：左侧导航键，右侧音量与电源 -->
            <Border Width="1" Height="15" Margin="5,0,8,0" VerticalAlignment="Center"
                    Background="#FF4A4A55" />

            <!-- 音量+ 按住持续增大（keyevent 24） -->
            <Button Style="{StaticResource NavButtonStyle}" Tag="24:repeat"
                    ToolTip="音量+ 按住持续增大（keyevent 24）"
                    Click="NavButton_Click"
                    PreviewMouseLeftButtonDown="NavButton_PreviewMouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="NavButton_PreviewMouseLeftButtonUp"
                    MouseLeave="NavButton_MouseLeave"
                    LostMouseCapture="NavButton_LostMouseCapture">
                <Viewbox Width="13" Height="13" Stretch="Uniform">
                    <Path Data="M3,6.3 L5.6,6.3 L9,3.2 L9,12.8 L5.6,9.7 L3,9.7 Z M11.8,8 L15.8,8 M13.8,6 L13.8,10"
                          Stroke="#FFF2F2F2" StrokeThickness="1.5" StrokeLineJoin="Round"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"
                          Width="16" Height="16" Stretch="Uniform" />
                </Viewbox>
            </Button>

            <!-- 音量- 按住持续减小（keyevent 25） -->
            <Button Style="{StaticResource NavButtonStyle}" Tag="25:repeat"
                    ToolTip="音量- 按住持续减小（keyevent 25）"
                    Click="NavButton_Click"
                    PreviewMouseLeftButtonDown="NavButton_PreviewMouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="NavButton_PreviewMouseLeftButtonUp"
                    MouseLeave="NavButton_MouseLeave"
                    LostMouseCapture="NavButton_LostMouseCapture">
                <Viewbox Width="13" Height="13" Stretch="Uniform">
                    <Path Data="M3,6.3 L5.6,6.3 L9,3.2 L9,12.8 L5.6,9.7 L3,9.7 Z M11.8,8 L15.8,8"
                          Stroke="#FFF2F2F2" StrokeThickness="1.5" StrokeLineJoin="Round"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"
                          Width="16" Height="16" Stretch="Uniform" />
                </Viewbox>
            </Button>

            <!-- 电源 短按亮灭屏 / 长按（松开即触发）（keyevent 26） -->
            <Button Style="{StaticResource NavButtonStyle}" Tag="26:longpress"
                    ToolTip="电源 短按亮灭屏 / 长按（松开即触发）（keyevent 26）"
                    Click="NavButton_Click"
                    PreviewMouseLeftButtonDown="NavButton_PreviewMouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="NavButton_PreviewMouseLeftButtonUp"
                    MouseLeave="NavButton_MouseLeave"
                    LostMouseCapture="NavButton_LostMouseCapture">
                <Viewbox Width="13" Height="13" Stretch="Uniform">
                    <Path Data="M8,2 L8,8.5 M4.2,4.4 A6,6 0 1 0 11.8,4.4"
                          Stroke="#FFF2F2F2" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"
                          Width="16" Height="16" Stretch="Uniform" />
                </Viewbox>
            </Button>
        </StackPanel>

        <!-- 隐藏的文本框负责接收键盘字符输入（WPF 文本输入需要可聚焦元素） -->
        <TextBox x:Name="_textSink" Grid.Row="3" Width="1" Height="1" Opacity="0"
                 IsTabStop="False" PreviewTextInput="TextSink_PreviewTextInput" />
    </Grid>
</Window>
