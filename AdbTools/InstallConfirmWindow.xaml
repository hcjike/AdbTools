<Window x:Class="AdbTools.InstallConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="安装应用" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#FFF3F4F6" FontSize="13"
        ShowInTaskbar="False" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Closed="Window_Closed">
    <Grid Margin="10">
        <Border Background="White" CornerRadius="12" BorderBrush="#FFE5E7EB" BorderThickness="1">
            <StackPanel>
                <!-- 应用信息：浅蓝底 + 左侧蓝条，名称与包名都自动换行 -->
                <Border Background="#FFF3F8FF" CornerRadius="12,12,0,0" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="4" CornerRadius="2" Background="#FF2A9FFF" Margin="0,2,12,2"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="appNameText" FontSize="17" FontWeight="Bold"
                                       Foreground="#FF1F2937" TextWrapping="Wrap"/>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#FFE1EDFF" CornerRadius="4" Padding="7,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="包名" FontSize="13" Foreground="#FF2A9FFF"/>
                                </Border>
                                <TextBlock x:Name="packageText" Grid.Column="1" FontFamily="Consolas"
                                           FontSize="13" FontWeight="Bold" Foreground="#FF2563EB"
                                           Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Margin="16,12,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#FFF1F5F9" CornerRadius="4" Padding="7,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="文件" FontSize="13" Foreground="#FF64748B"/>
                    </Border>
                    <TextBlock x:Name="fileText" Grid.Column="1" FontSize="13" Foreground="#FF374151"
                               Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </Grid>

                <Grid Margin="16,10,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#FFE7F8F1" CornerRadius="4" Padding="7,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="设备" FontSize="13" Foreground="#FF059669"/>
                    </Border>
                    <TextBlock x:Name="deviceText" Grid.Column="1" FontSize="13" FontWeight="SemiBold"
                               Foreground="#FF111827" Margin="10,0,0,0" VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                </Grid>

                <Border Height="1" Background="#FFF0F2F5" Margin="16,14,16,0"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,12,16,14">
                    <Button Content="取消 (ESC)" Style="{StaticResource UserButtonStyle}" IsCancel="True"
                            Width="108" Height="34" Background="#FFE5E7EB" Foreground="#FF374151"/>
                    <Button x:Name="installButton" Content="安装 (Enter)" Style="{StaticResource UserButtonStyle}"
                            IsDefault="True" IsEnabled="False" Width="108" Height="34" Margin="10,0,0,0"
                            Background="#FF2A9FFF" Foreground="White" Click="install_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
