<Window x:Class="AdbTools.Windows.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdbTools"
        mc:Ignorable="d"
        Title="InputWindow" FontSize="13" Width="440"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        UseLayoutRounding="True" Loaded="Window_Loaded">

    <!-- 外层留出 16px 给投影，否则阴影会被透明窗口边缘裁掉 -->
    <Grid Margin="16">
        <Border Background="White" CornerRadius="10" SnapsToDevicePixels="True"
                BorderBrush="#FFE5E7EB" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#FF1F2937" Opacity="0.18"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题区：浅灰底 + 底部分隔线，与正文明确分开 -->
                <Border Grid.Row="0" Background="#FFF1F3F6" CornerRadius="9,9,0,0"
                        BorderBrush="#FFE5E7EB" BorderThickness="0,0,0,1"
                        SnapsToDevicePixels="True">
                    <Grid Margin="14,10,14,10" Background="Transparent"
                          MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <TextBlock x:Name="titleText" FontSize="15" FontWeight="SemiBold"
                                   Foreground="#FF1F2937" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="14,12,14,12">
                    <!-- 说明/错误提示：默认隐藏，没有 Hint 时不占位；过长时自动换行，
                         ToolTip 仍保留完整内容。由代码用 Inlines 拼装，以便把路径、原文件名等高亮显示。 -->
                    <TextBlock x:Name="hintText" FontSize="13" Foreground="#FF6B7280"
                               TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="Collapsed"/>
                    <!-- 长名字自动换行，窗口随内容变高；输入框最少 3 行、最多 10 行（代码里按字体实测行高），
                         超过 10 行后不再撑高窗口，改为输入框内部滚动。 -->
                    <TextBox x:Name="content" Style="{StaticResource UserTextBox}"
                             Padding="10,8" FontSize="14"
                             HorizontalContentAlignment="Left" VerticalContentAlignment="Top"
                             AcceptsReturn="False" TextWrapping="Wrap" TabIndex="0"
                             VerticalScrollBarVisibility="Auto"
                             TextChanged="content_TextChanged"/>
                    <!-- 校验错误：显示在输入框下方，默认隐藏；不覆盖上方的固定说明 -->
                    <TextBlock x:Name="errorText" FontSize="12" Foreground="#FFDC2626"
                               TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>

                <!-- 按钮区：浅灰底 + 顶部分隔线，与正文明确分开 -->
                <Border Grid.Row="2" Background="#FFF8FAFC" CornerRadius="0,0,9,9"
                        BorderBrush="#FFEEF0F3" BorderThickness="0,1,0,0"
                        SnapsToDevicePixels="True">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                Margin="14,10,14,10">
                        <Button x:Name="cancle" Style="{StaticResource UserSecondaryButtonStyle}" Content="取消"
                                Width="88" Height="32" Margin="0,0,10,0" TabIndex="2"
                                IsCancel="True" Click="cancle_Click"/>
                        <Button x:Name="enter" Style="{StaticResource UserButtonStyle}" Content="确定"
                                Width="88" Height="32" TabIndex="1"
                                Background="#FF2A9FFF" Foreground="White"
                                IsDefault="True" Click="enter_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
