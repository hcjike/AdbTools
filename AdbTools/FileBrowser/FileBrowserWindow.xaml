<Window x:Class="AdbTools.FileBrowser.FileBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文件浏览" Height="740" Width="1020" MinHeight="480" MinWidth="820"
        WindowStartupLocation="CenterScreen" Background="#FFF3F4F6" FontSize="14"
        Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <WrapPanel Grid.Row="0" Orientation="Horizontal">
            <Button Content="上级" Click="up_Click" Padding="12,4" Margin="0,0,6,0"/>
            <Button Content="刷新" Click="refresh_Click" Padding="12,4" Margin="0,0,6,0"/>
            <Button Content="新建文件夹" Click="newFolder_Click" Padding="12,4" Margin="0,0,6,0"/>
            <Button Content="上传文件" Click="uploadFile_Click" Padding="12,4" Margin="0,0,6,0"/>
            <Button Content="上传文件夹" Click="uploadFolder_Click" Padding="12,4" Margin="0,0,6,0"/>
            <Button Content="下载" Click="download_Click" Padding="12,4" Margin="0,0,6,0"/>
            <Button Content="重命名" Click="rename_Click" Padding="12,4" Margin="0,0,6,0"/>
            <Button Content="删除" Click="delete_Click" Padding="12,4" Foreground="#FFEF4444"/>
        </WrapPanel>

        <!-- 路径栏 -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="pathBox" Padding="6,5" VerticalContentAlignment="Center" KeyDown="pathBox_KeyDown"/>
            <Button Grid.Column="1" Content="前往" Click="go_Click" Padding="12,4" Margin="6,0,0,0"/>
        </Grid>

        <!-- 文件列表 -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <ListView x:Name="fileList" Background="White"
                      SelectionMode="Extended" MouseDoubleClick="fileList_MouseDoubleClick" KeyDown="fileList_KeyDown">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="名称" Width="390">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <Image Source="{Binding Icon}" Width="22" Height="22" Stretch="Uniform"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Name}" FontSize="15" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="类型" Width="80" DisplayMemberBinding="{Binding TypeText}"/>
                        <GridViewColumn Header="大小" Width="110" DisplayMemberBinding="{Binding SizeText}"/>
                        <GridViewColumn Header="修改时间" Width="150" DisplayMemberBinding="{Binding ModifiedText}"/>
                        <GridViewColumn Header="权限" Width="120" DisplayMemberBinding="{Binding Permissions}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- 空目录 / 无权限 / 读取失败时覆盖在列表区域中央，比只在状态栏提示更醒目 -->
            <Border x:Name="listNotice" Background="#F2F9FAFB" BorderBrush="#FFE5E7EB" BorderThickness="1"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                    <TextBlock x:Name="noticeTitle" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Foreground="#FF374151"/>
                    <TextBlock x:Name="noticeDetail" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="14"
                               TextAlignment="Center" Foreground="#FF6B7280" LineHeight="22"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Button x:Name="noticeBackButton" Content="返回上级" Click="noticeBack_Click"
                                Padding="16,4" Margin="0,0,8,0" Visibility="Collapsed"/>
                        <Button Content="刷新" Click="noticeRefresh_Click" Padding="16,4"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 状态栏与传输控制 -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="statusText" VerticalAlignment="Center" Foreground="#FF4B5563" TextTrimming="CharacterEllipsis"/>
            <ProgressBar x:Name="transferBar" Grid.Column="1" Width="160" Height="8"
                         IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center"/>
            <Button x:Name="cancelButton" Grid.Column="2" Content="取消传输" Click="cancelTransfer_Click"
                    Padding="12,4" Margin="8,0,0,0" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
