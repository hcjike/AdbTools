<Window x:Class="AdbTools.FileBrowser.FileBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文件管理" Height="740" Width="1020" MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterScreen" Background="#FFF3F4F6" FontSize="13"
        Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <!-- 工具栏按钮：全局蓝底白字圆角风格，统一字体大小 -->
        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource UserButtonStyle}">
            <Setter Property="Background" Value="#FF2A9FFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- 图标按钮：正方形、无内边距，用于路径栏快速跳转 -->
        <Style x:Key="IconButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource UserButtonStyle}">
            <Setter Property="Background" Value="#FF2A9FFF"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏：导航 | 地址 | 文件操作 | 修改与删除，用竖线分组 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 导航 -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButtonStyle}" Click="up_Click" ToolTip="返回上一级目录">
                    <Path Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"
                          Fill="White" Stretch="Uniform" Width="16" Height="16"/>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="root_Click" ToolTip="跳转到设备根目录 /">
                    <Path Data="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"
                          Fill="White" Stretch="Uniform" Width="16" Height="16"/>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="sdcard_Click" ToolTip="跳转到 SD 卡目录 /sdcard">
                    <Path Data="M18 2h-8L4.02 8 4 20c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-6 6h-2V4h2v4zm3 0h-2V4h2v4zm3 0h-2V4h2v4z"
                          Fill="White" Stretch="Uniform" Width="16" Height="16"/>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Margin="0" Click="refresh_Click" ToolTip="刷新当前目录列表">
                    <Path Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                          Fill="White" Stretch="Uniform" Width="16" Height="16"/>
                </Button>
            </StackPanel>

            <Border Grid.Column="1" Width="1" Background="#FFE5E7EB" Margin="8,4"/>

            <!-- 地址 -->
            <Grid Grid.Column="2" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="pathBox" Padding="6,5" VerticalContentAlignment="Center"/>
                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Margin="6,0,0,0" Click="go_Click" ToolTip="前往输入框中的路径">
                    <TextBlock Text="GO" FontSize="12" FontWeight="Bold" Foreground="White"/>
                </Button>
            </Grid>

            <Border Grid.Column="3" Width="1" Background="#FFE5E7EB" Margin="8,4"/>

            <!-- 文件操作 -->
            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButtonStyle}" Background="#FF10B981" Click="newFolder_Click" ToolTip="在设备当前目录新建文件夹">
                    <Path Data="F0 M20 6h-8l-2-2H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2z M11 10H13V13H16V15H13V18H11V15H8V13H11Z"
                          Fill="White" Stretch="Uniform" Width="18" Height="18"/>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Background="#FF10B981" Click="uploadFile_Click" ToolTip="上传文件：从电脑上传到设备当前目录">
                    <Path Data="F0 M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6z M12 9L8 13H10.5v4h3v-4H16z"
                          Fill="White" Stretch="Uniform" Width="18" Height="18"/>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Background="#FF10B981" Click="uploadFolder_Click" ToolTip="上传文件夹：从电脑上传到设备当前目录">
                    <Path Data="F0 M20 6h-8l-2-2H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2z M12 10L8 14H10.5v4h3v-4H16z"
                          Fill="White" Stretch="Uniform" Width="18" Height="18"/>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Margin="0" Background="#FF10B981" Click="download_Click" ToolTip="下载：从设备下载到电脑（选择本地保存位置）">
                    <Path Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"
                          Fill="White" Stretch="Uniform" Width="18" Height="18"/>
                </Button>
            </StackPanel>

            <Border Grid.Column="5" Width="1" Background="#FFE5E7EB" Margin="8,4"/>

            <!-- 修改与删除 -->
            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButtonStyle}" Background="#FFF59E0B" Click="rename_Click" ToolTip="重命名选中的文件或文件夹">
                    <Path Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"
                          Fill="White" Stretch="Uniform" Width="18" Height="18"/>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Margin="0" Background="#FFEF4444" Click="delete_Click" ToolTip="删除选中的文件或文件夹（不可恢复）">
                    <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                          Fill="White" Stretch="Uniform" Width="18" Height="18"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 文件列表 -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <ListView x:Name="fileList" Background="White" AllowDrop="True"
                      DragOver="fileList_DragOver" Drop="fileList_Drop"
                      PreviewMouseLeftButtonDown="fileList_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="fileList_PreviewMouseMove"
                      PreviewMouseLeftButtonUp="fileList_PreviewMouseLeftButtonUp"
                      SelectionMode="Extended" MouseDoubleClick="fileList_MouseDoubleClick"
                      SelectionChanged="fileList_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="名称" Width="450">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <Image Source="{Binding Icon}" Width="20" Height="20" Stretch="Uniform"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Name}" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="类型" Width="80" DisplayMemberBinding="{Binding TypeText}"/>
                        <GridViewColumn Header="大小" Width="110" DisplayMemberBinding="{Binding SizeText}"/>
                        <GridViewColumn Header="修改时间" Width="150" DisplayMemberBinding="{Binding ModifiedText}"/>
                        <GridViewColumn Header="权限" Width="120" DisplayMemberBinding="{Binding Permissions}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- 空目录 / 无权限 / 读取失败时覆盖在列表区域中央，比只在状态栏提示更醒目 -->
            <Border x:Name="listNotice" Background="#F2F9FAFB" BorderBrush="#FFE5E7EB" BorderThickness="1"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                    <TextBlock x:Name="noticeTitle" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Foreground="#FF374151"/>
                    <TextBlock x:Name="noticeDetail" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="14"
                               TextAlignment="Center" Foreground="#FF6B7280" LineHeight="22"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Button x:Name="noticeBackButton" Content="返回上级" Click="noticeBack_Click"
                                Padding="16,4" Margin="0,0,8,0" Visibility="Collapsed"/>
                        <Button Content="刷新" Click="noticeRefresh_Click" Padding="16,4"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 底部：状态信息与传输控制 -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="statusText" VerticalAlignment="Center" Foreground="#FF4B5563" TextTrimming="CharacterEllipsis"/>
            <ProgressBar x:Name="transferBar" Grid.Column="1" Width="160" Height="8" Margin="10,0,0,0"
                         IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center"/>
            <Button x:Name="cancelButton" Grid.Column="2" Content="取消传输" Click="cancelTransfer_Click"
                    Padding="12,4" Margin="10,0,0,0" Visibility="Collapsed" Background="#FFEF4444"/>
        </Grid>
    </Grid>
</Window>
