<Window x:Class="AdbTools.FileBrowser.FileBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文件管理" Height="740" Width="1020" MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterScreen" Background="#FFF3F4F6" FontSize="13"
        Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <!-- 工具栏按钮：全局蓝底白字圆角风格，统一字体大小 -->
        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource UserButtonStyle}">
            <Setter Property="Background" Value="#FF2A9FFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- 传输进度条：底槽与填充都做成圆角（高度 24 → 半径 12）；
             不确定态用一条来回呼吸的圆角条代替默认动画 -->
        <Style x:Key="RoundedProgressBar" TargetType="{x:Type ProgressBar}">
            <Setter Property="Height" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Grid ClipToBounds="True">
                            <!-- 底槽 -->
                            <Border x:Name="PART_Track" CornerRadius="12"
                                    Background="{TemplateBinding Background}" />
                            <!-- 填充段 -->
                            <Border x:Name="PART_Indicator" CornerRadius="12"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" />
                            <!-- 不确定态：整条淡色填充（不做动画，避免模板名称域解析问题） -->
                            <Border x:Name="pulseBar" CornerRadius="12" Visibility="Collapsed"
                                    Opacity="0.45" Background="{TemplateBinding Foreground}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="pulseBar" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 图标按钮：正方形、无内边距，用于路径栏快速跳转 -->
        <Style x:Key="IconButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource UserButtonStyle}">
            <Setter Property="Background" Value="#FF2A9FFF"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <!-- 列头：自定义模板去掉默认的拖动分隔条（列宽由代码按比例锁定），
             保留点击排序；浅灰底 + 底部细线，和工具栏的分隔风格一致。 -->
        <Style TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="Foreground" Value="#FF4B5563"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                        <Border x:Name="bg" Background="#FFF7F8FA" BorderBrush="#FFE9EBEF"
                                BorderThickness="0,0,0,1" Padding="6,5" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#FFF1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#FFE8EEF6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 右键菜单里的分组提示条：浅色底、小字、圆角，看起来是一条说明而不是可点的菜单项。
             用自定义模板彻底去掉悬停高亮与按下态；IsEnabled=False 保证点不动也进不了键盘导航。 -->
        <Style x:Key="ContextHintMenuItemStyle" TargetType="{x:Type MenuItem}">
            <Setter Property="IsEnabled" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border Background="#FFEFF3F8" CornerRadius="4" Margin="4,3" Padding="8,4">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="False"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏：导航 | 地址 | 文件操作 | 修改与删除，用竖线分组 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 导航 -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="upButton" Style="{StaticResource IconButtonStyle}" Click="up_Click"
                        ToolTip="返回上一级目录">
                    <!-- 向上箭头：表示目录上溯，避免与浏览器的“后退”混淆 -->
                    <Viewbox Width="24" Height="24">
                        <Canvas Width="24" Height="24">
                            <Path Data="M12,19.4 V6.6" Stroke="White" StrokeThickness="3.1"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Path Data="M6.4,10.4 L12,4.6 L17.6,10.4" Stroke="White" StrokeThickness="3.1"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="root_Click" ToolTip="跳转到设备根目录 /">
                    <Path Data="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"
                          Fill="White" Stretch="Uniform" Width="21" Height="21"/>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="sdcard_Click" ToolTip="跳转到 SD 卡目录 /sdcard">
                    <Path Data="M18 2h-8L4.02 8 4 20c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-6 6h-2V4h2v4zm3 0h-2V4h2v4zm3 0h-2V4h2v4z"
                          Fill="White" Stretch="Uniform" Width="18" Height="18"/>
                </Button>
                <!-- 临时目录：与其它导航按钮同为蓝底，图标用「文件夹 + 终端提示符」区分 -->
                <Button Style="{StaticResource IconButtonStyle}" Click="tmp_Click"
                        ToolTip="跳转到临时目录 /data/local/tmp（shell 可读写，常用于 adb 调试）">
                    <Viewbox Width="21" Height="21">
                        <Canvas Width="24" Height="24">
                            <Path Data="M2,4 H9.2 L11.6,6.6 H22 V21 H2 Z" Fill="White"/>
                            <Path Data="M6.4,11.4 L10,14.8 L6.4,18.2" Stroke="#FF2A9FFF" StrokeThickness="2.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <Path Data="M12.4,18.2 H17.6" Stroke="#FF2A9FFF" StrokeThickness="2.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Viewbox>
                </Button>
                <!-- 应用数据：Android 机器人头像，进入可调试应用的私有目录列表 -->
                <Button Style="{StaticResource IconButtonStyle}" Click="appData_Click"
                        ToolTip="浏览第三方可调试应用的私有数据（/data/data，普通文件浏览无法查看）">
                    <Viewbox Width="27" Height="27">
                        <Canvas Width="24" Height="24">
                            <Path Data="M7.6,9.6 L6.2,6.2 M16.4,9.6 L17.8,6.2" Stroke="White" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Path Data="M4.2,16.4 A7.8,7.8 0 0 1 19.8,16.4 Z" Fill="White"/>
                            <Path Data="M7,12.6 A1.2,1.2 0 1 1 9.4,12.6 A1.2,1.2 0 1 1 7,12.6 Z"
                                  Fill="#FF2A9FFF"/>
                            <Path Data="M14.6,12.6 A1.2,1.2 0 1 1 17,12.6 A1.2,1.2 0 1 1 14.6,12.6 Z"
                                  Fill="#FF2A9FFF"/>
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Margin="0" Click="refresh_Click" ToolTip="刷新当前目录列表">
                    <Path Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                          Fill="White" Stretch="Uniform" Width="19" Height="19"/>
                </Button>
            </StackPanel>

            <Border Grid.Column="1" Width="1" Background="#FFE5E7EB" Margin="8,4"/>

            <!-- 地址 -->
            <Grid Grid.Column="2" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="pathBox" Padding="6,5" VerticalContentAlignment="Center"/>
                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Margin="6,0,0,0" Click="go_Click"
                        ToolTip="前往输入框中的路径（回车同样可用）">
                    <!-- 圆头粗箭头：与导航按钮的线面风格一致，缩到 30px 仍然清晰 -->
                    <Viewbox Width="24" Height="24">
                        <Canvas Width="24" Height="24">
                            <Path Data="M4.6,12 H17.4" Stroke="White" StrokeThickness="3.1"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Path Data="M13.6,6.4 L19.4,12 L13.6,17.6" Stroke="White" StrokeThickness="3.1"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                </Button>
            </Grid>

            <Border Grid.Column="3" Width="1" Background="#FFE5E7EB" Margin="8,4"/>

            <!-- 文件操作 -->
            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="newFolderButton" Style="{StaticResource IconButtonStyle}" Background="#FF10B981" Click="newFolder_Click" ToolTip="在设备当前目录新建文件夹">
                    <Path Data="F0 M20 6h-8l-2-2H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2z M11 10H13V13H16V15H13V18H11V15H8V13H11Z"
                          Fill="White" Stretch="Uniform" Width="18" Height="18"/>
                </Button>
                <Button x:Name="uploadFileButton" Style="{StaticResource IconButtonStyle}" Background="#FF10B981" Click="uploadFile_Click" ToolTip="上传文件：从电脑上传到设备当前目录">
                    <Path Data="F0 M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6z M12 9L8 13H10.5v4h3v-4H16z"
                          Fill="White" Stretch="Uniform" Width="18" Height="18"/>
                </Button>
                <Button x:Name="uploadFolderButton" Style="{StaticResource IconButtonStyle}" Background="#FF10B981" Click="uploadFolder_Click" ToolTip="上传文件夹：从电脑上传到设备当前目录">
                    <Path Data="F0 M20 6h-8l-2-2H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2z M12 10L8 14H10.5v4h3v-4H16z"
                          Fill="White" Stretch="Uniform" Width="18" Height="18"/>
                </Button>
                <Button x:Name="downloadButton" Style="{StaticResource IconButtonStyle}" Margin="0" Background="#FF10B981" Click="download_Click" ToolTip="下载：从设备下载到电脑（选择本地保存位置）">
                    <Path Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"
                          Fill="White" Stretch="Uniform" Width="18" Height="18"/>
                </Button>
            </StackPanel>

            <Border Grid.Column="5" Width="1" Background="#FFE5E7EB" Margin="8,4"/>

            <!-- 修改与删除 -->
            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="renameButton" Style="{StaticResource IconButtonStyle}" Background="#FFF59E0B" Click="rename_Click" ToolTip="重命名选中的文件或文件夹">
                    <Path Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"
                          Fill="White" Stretch="Uniform" Width="20" Height="20"/>
                </Button>
                <Button x:Name="deleteButton" Style="{StaticResource IconButtonStyle}" Margin="0" Background="#FFEF4444" Click="delete_Click" ToolTip="删除选中的文件或文件夹（不可恢复）">
                    <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                          Fill="White" Stretch="Uniform" Width="20" Height="20"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 文件列表 -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <ListView x:Name="fileList" Background="White" AllowDrop="True"
                      DragEnter="fileList_DragEnter" DragOver="fileList_DragOver"
                      DragLeave="fileList_DragLeave" Drop="fileList_Drop"
                      PreviewMouseLeftButtonDown="fileList_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="fileList_PreviewMouseMove"
                      PreviewMouseLeftButtonUp="fileList_PreviewMouseLeftButtonUp"
                      PreviewMouseRightButtonDown="fileList_PreviewMouseRightButtonDown"
                      ContextMenuOpening="fileList_ContextMenuOpening"
                      SelectionMode="Extended" MouseDoubleClick="fileList_MouseDoubleClick"
                      SelectionChanged="fileList_SelectionChanged"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <!-- 右键菜单：真实目录下提供打开/下载/上传/新建/重命名/删除，
                     应用列表里只保留打开/下载应用数据/解析应用/筛选/刷新。
                     上传与新建作用在「当前文件夹」，重命名与删除作用在「选中项」，
                     这两组各用一个灰色标题标出操作目标，避免看错对象。
                     各项的可见性与可用性在 Opened 里按当前选择动态计算。 -->
                <ListView.ContextMenu>
                    <ContextMenu x:Name="fileContextMenu" Opened="FileContextMenu_Opened" MinWidth="200">
                        <MenuItem x:Name="ctxOpenMenuItem" Header="打开" Click="contextOpen_Click"/>
                        <MenuItem x:Name="ctxDownloadMenuItem" Header="下载到电脑" Click="download_Click"/>
                        <Separator x:Name="ctxSepFileOps"/>
                        <MenuItem x:Name="ctxFolderGroupMenuItem"
                                  Style="{StaticResource ContextHintMenuItemStyle}"
                                  ToolTipService.ShowOnDisabled="True">
                            <MenuItem.Header>
                                <TextBlock x:Name="ctxFolderGroupText" FontSize="11.5"
                                           FontWeight="SemiBold" Foreground="#FF475569"
                                           MaxWidth="240" TextTrimming="CharacterEllipsis"/>
                            </MenuItem.Header>
                        </MenuItem>
                        <MenuItem x:Name="ctxUploadFileMenuItem" Header="上传文件" Click="uploadFile_Click"/>
                        <MenuItem x:Name="ctxUploadFolderMenuItem" Header="上传文件夹" Click="uploadFolder_Click"/>
                        <MenuItem x:Name="ctxNewFolderMenuItem" Header="新建文件夹" Click="newFolder_Click"/>
                        <Separator x:Name="ctxSepEdit"/>
                        <MenuItem x:Name="ctxSelectionGroupMenuItem"
                                  Style="{StaticResource ContextHintMenuItemStyle}"
                                  ToolTipService.ShowOnDisabled="True">
                            <MenuItem.Header>
                                <TextBlock x:Name="ctxSelectionGroupText" FontSize="11.5"
                                           FontWeight="SemiBold" Foreground="#FF475569"
                                           MaxWidth="240" TextTrimming="CharacterEllipsis"/>
                            </MenuItem.Header>
                        </MenuItem>
                        <MenuItem x:Name="ctxRenameMenuItem" Header="重命名" Click="rename_Click"/>
                        <MenuItem x:Name="ctxDeleteMenuItem" Header="删除" Click="delete_Click"/>
                        <Separator x:Name="ctxSepPackage"/>
                        <MenuItem x:Name="ctxResolveAppMenuItem" Header="解析应用"
                                  ToolTip="从设备重新获取并更新该应用的应用名与图标，不删除已有缓存"
                                  Click="resolveAppMenuItem_Click"/>
                        <MenuItem x:Name="ctxFilterMenuItem" Header="显示全部" Click="packageFilter_Click"/>
                        <MenuItem x:Name="ctxRefreshMenuItem" Header="刷新" Click="refresh_Click"/>
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="名称" Width="470">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2" Background="Transparent"
                                                ToolTip="{Binding FullPath}">
                                        <Image Source="{Binding Icon}" Width="22" Height="22" Stretch="Uniform"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Foreground" Value="#FF1F2937"/>
                                                    <Style.Triggers>
                                                        <!-- 打不开的应用（非debug）灰显，一眼能区分 -->
                                                        <DataTrigger Binding="{Binding CanOpen}" Value="False">
                                                            <Setter Property="Foreground" Value="#FF9CA3AF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- 目录名是包名时（/data/data、/sdcard/Android/data 等）补上应用名，
                                             用高饱和蓝色突出，和前面深灰的包名区分开 -->
                                        <TextBlock Text="{Binding AppLabelText}" FontSize="13"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                                   MaxWidth="240" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Foreground" Value="#FF2563EB"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanOpen}" Value="False">
                                                            <Setter Property="Foreground" Value="#FFB4BCC8"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="类型" Width="92">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TypeText}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Foreground" Value="#FF374151"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanOpen}" Value="False">
                                                        <Setter Property="Foreground" Value="#FF9CA3AF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="大小" Width="110" DisplayMemberBinding="{Binding SizeText}"/>
                        <GridViewColumn Header="修改时间" Width="150" DisplayMemberBinding="{Binding ModifiedText}"/>
                        <GridViewColumn Header="权限" Width="120" DisplayMemberBinding="{Binding Permissions}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- 空目录 / 无权限 / 读取失败时覆盖在列表区域中央，比只在状态栏提示更醒目。
                 覆盖层会挡住下面的 ListView，所以这里也要接收拖放，否则空目录时无法拖拽上传。 -->
            <Border x:Name="listNotice" Background="#F2F9FAFB" BorderBrush="#FFE5E7EB" BorderThickness="1"
                    Visibility="Collapsed" AllowDrop="True"
                    DragEnter="fileList_DragEnter" DragOver="fileList_DragOver"
                    DragLeave="fileList_DragLeave" Drop="fileList_Drop">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                    <TextBlock x:Name="noticeTitle" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Foreground="#FF374151"/>
                    <TextBlock x:Name="noticeDetail" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="14"
                               TextAlignment="Center" Foreground="#FF6B7280" LineHeight="22"/>
                    <TextBlock x:Name="noticeDropHint" Margin="0,8,0,0" FontSize="13"
                               HorizontalAlignment="Center" Foreground="#FF059669"
                               Text="可直接把文件或文件夹拖到这里上传"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Button x:Name="noticeBackButton" Content="返回上级" Click="noticeBack_Click"
                                Padding="16,4" Margin="0,0,8,0" Visibility="Collapsed"/>
                        <Button Content="刷新" Click="noticeRefresh_Click" Padding="16,4"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 拖拽提示：跟随拖动显示将上传的文件夹/文件数量。
                 IsHitTestVisible=False，完全不干扰下面的拖放事件。 -->
            <Border x:Name="dropHintBorder" Background="#CC1F2937" Visibility="Collapsed"
                    IsHitTestVisible="False">
                <Border Background="#EE111827" CornerRadius="10" Padding="18,12"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="dropHintText" FontSize="15" FontWeight="SemiBold"
                               Foreground="White" TextAlignment="Center" TextWrapping="Wrap"
                               MaxWidth="520" />
                </Border>
            </Border>

            <!-- 操作结果提示：默认隐藏，操作后显示最多 5 秒 -->
            <Border x:Name="actionTip" Visibility="Collapsed" HorizontalAlignment="Center"
                    VerticalAlignment="Bottom" Margin="0,0,0,12" MaxWidth="760"
                    Background="#E60F172A" CornerRadius="8" Padding="14,7"
                    IsHitTestVisible="False" Panel.ZIndex="2">
                <TextBlock x:Name="actionTipText" Foreground="White" FontSize="12.5"
                           TextWrapping="Wrap" TextAlignment="Center" />
            </Border>

        </Grid>

        <!-- 底部：状态信息、应用列表筛选与传输控制 -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- 状态栏：左侧蓝色竖线做视觉锚点，文字用接近正文的深色且不随状态变色；
                 数字用等宽字形，进度从 99/161 跳到 100/161 时文本不会左右抖动 -->
            <Grid Grid.Column="0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="3" CornerRadius="1.5" Background="#FF2A9FFF"
                        Margin="0,1,10,1" VerticalAlignment="Stretch"/>
                <TextBlock x:Name="statusText" Grid.Column="1" VerticalAlignment="Center"
                           Foreground="#FF111827"
                           TextTrimming="CharacterEllipsis"
                           TextOptions.TextFormattingMode="Display"
                           Typography.NumeralAlignment="Tabular"/>
            </Grid>
            <!-- 应用列表里用于切换“只看可访问 / 显示全部”，其余目录时隐藏 -->
            <Button x:Name="packageFilterButton" Grid.Column="1" Content="显示全部" Click="packageFilter_Click"
                    Visibility="Collapsed" Background="Transparent" Foreground="#FF2A9FFF"
                    Padding="6,2" Margin="10,0,0,0" ToolTip="显示或隐藏非debug应用" />
            <!-- 传输进度：加高的进度条 + 居中的「已完成/总数」文字 -->
            <Grid x:Name="transferProgress" Grid.Column="2" Width="190" Height="24" Margin="12,0,0,0"
                  Visibility="Collapsed" VerticalAlignment="Center">
                <ProgressBar x:Name="transferBar" Minimum="0" Maximum="1" Value="0"
                             IsIndeterminate="True" Height="24" VerticalAlignment="Center"
                             Style="{StaticResource RoundedProgressBar}"
                             Foreground="#FF2A9FFF" Background="#FFE8EBEF" BorderThickness="0" />
                <!-- 文字为空时整个徽标隐藏，避免只剩一个深色小圆点 -->
                <Border Background="#CC1F2937" CornerRadius="10" Padding="9,1"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=transferProgressText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock x:Name="transferProgressText" Text=""
                               Foreground="White" FontSize="11.5" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
            <Button x:Name="cancelButton" Grid.Column="3" Content="停止传输" Click="cancelTransfer_Click"
                    ToolTip="中止本次全部传输"
                    Padding="12,4" Margin="10,0,0,0" Visibility="Collapsed" Background="#FFEF4444"/>
        </Grid>
    </Grid>
</Window>
