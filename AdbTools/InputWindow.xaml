<Window x:Class="AdbTools.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdbTools"
        mc:Ignorable="d"
        Title="InputWindow" FontSize="13" Width="440"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        UseLayoutRounding="True" Loaded="Window_Loaded">

    <Window.Resources>
        <!-- 关闭按钮：无边框窗口的自绘关闭键，悬停时浅红底 + 红色叉 -->
        <Style x:Key="CloseButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="6">
                            <Path x:Name="icon" Data="M0,0 L10,10 M10,0 L0,10"
                                  Stroke="#FF6B7280" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#FFFDECEC"/>
                                <Setter TargetName="icon" Property="Stroke" Value="#FFEF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 外层留出 16px 给投影，否则阴影会被透明窗口边缘裁掉 -->
    <Grid Margin="16">
        <Border Background="White" CornerRadius="10" SnapsToDevicePixels="True"
                BorderBrush="#FFE5E7EB" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#FF1F2937" Opacity="0.18"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题栏：整行可拖动，右侧关闭按钮 -->
                <Grid Grid.Row="0" Margin="18,12,10,0" Background="Transparent"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <TextBlock x:Name="titleText" FontSize="15" FontWeight="SemiBold"
                               Foreground="#FF1F2937" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="closeButton" Style="{StaticResource CloseButtonStyle}"
                            Width="28" Height="28" HorizontalAlignment="Right"
                            VerticalAlignment="Center" ToolTip="关闭" Click="cancle_Click"/>
                </Grid>

                <StackPanel Grid.Row="1" Margin="18,14,18,0">
                    <!-- 说明/错误提示：默认隐藏，没有 Hint 时不占位；过长时省略，ToolTip 给完整内容。
                         由代码用 Inlines 拼装，以便把路径、原文件名等高亮显示。 -->
                    <TextBlock x:Name="hintText" FontSize="12" Foreground="#FF6B7280"
                               TextTrimming="CharacterEllipsis" Margin="0,0,0,8"
                               Visibility="Collapsed"/>
                    <!-- 长名字允许换行，窗口会随内容自然变高 -->
                    <TextBox x:Name="content" Style="{StaticResource UserTextBox}"
                             MinHeight="38" Padding="10,8" FontSize="14"
                             HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                             AcceptsReturn="False" TextWrapping="Wrap" TabIndex="0"
                             TextChanged="content_TextChanged"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="18,18,18,18">
                    <Button x:Name="cancle" Style="{StaticResource UserButtonStyle}" Content="取消"
                            Width="88" Height="32" Margin="0,0,10,0" TabIndex="2"
                            Background="#FFF3F4F6" Foreground="#FF4B5563"
                            IsCancel="True" Click="cancle_Click"/>
                    <Button x:Name="enter" Style="{StaticResource UserButtonStyle}" Content="确定"
                            Width="88" Height="32" TabIndex="1"
                            Background="#FF2A9FFF" Foreground="White"
                            IsDefault="True" Click="enter_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
