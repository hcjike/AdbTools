<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="AdbTools.ApkInstallWindow"
        Title="安装应用" Width="650" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" Background="#FFF3F4F6" FontSize="13"
        ShowInTaskbar="False" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Closed="Window_Closed" ResizeMode="NoResize" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="ToolButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource UserButtonStyle}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Background" Value="#FF2563EB" />
        </Style>

        <Style x:Key="StartButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ToolButtonStyle}">
            <Setter Property="Background" Value="#FF10B981" />
        </Style>

        <Style x:Key="CancelButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ToolButtonStyle}">
            <Setter Property="Background" Value="#FF6B7280" />
        </Style>

        <Style x:Key="SelectAllToolButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ToolButtonStyle}">
            <Setter Property="Background" Value="#FF0EA5E9" />
        </Style>

        <Style x:Key="InvertToolButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ToolButtonStyle}">
            <Setter Property="Background" Value="#FF7C3AED" />
        </Style>

        <Style x:Key="ClearSelectionToolButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ToolButtonStyle}">
            <Setter Property="Background" Value="#FF0D9488" />
        </Style>

        <Style x:Key="RemoveToolButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ToolButtonStyle}">
            <Setter Property="Background" Value="#FFDC2626" />
        </Style>

        <Style x:Key="AddToolButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ToolButtonStyle}">
            <Setter Property="Background" Value="#FF0D9488" />
        </Style>

        <Style x:Key="ApkCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFE5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF9FBFE" />
                    <Setter Property="BorderBrush" Value="#FFBFD8FF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ApkPathToolTipTemplate">
            <StackPanel MaxWidth="420">
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="#FF0F172A" />
                <TextBlock Text="{Binding FilePath}" FontFamily="Consolas" FontSize="12"
                           Foreground="#FF475569" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="0">
        <Border Background="White" CornerRadius="10" BorderBrush="#FFE5E7EB" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#FFF8FAFC" CornerRadius="10,10,0,0"
                        BorderBrush="#FFE5E7EB" BorderThickness="0,0,0,1" Padding="12">
                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#FFE7F8F1" CornerRadius="6" Padding="8,3"
                                VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="设备" FontSize="12" Foreground="#FF059669"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                        </Border>

                        <TextBlock x:Name="deviceText" Grid.Column="1" Foreground="#FF000000"
                                   FontWeight="SemiBold" MaxWidth="420" TextWrapping="Wrap"
                                   TextAlignment="Center" VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />

                        <Border x:Name="deviceSdkChip" Grid.Column="2" Visibility="Collapsed"
                                VerticalAlignment="Center" CornerRadius="4" Padding="8,1"
                                Margin="8,0,0,0" Background="#FF2563EB">
                            <TextBlock x:Name="deviceSdkText" Foreground="White" FontSize="11.5"
                                       FontWeight="SemiBold" TextAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="12,10,12,0">
                    <ListBox x:Name="apkList"
                             MaxHeight="520" MinHeight="80" BorderThickness="0" Background="Transparent"
                             SelectionMode="Extended" SelectionChanged="ApkList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             AllowDrop="True" DragEnter="ApkList_DragEnter"
                             DragLeave="ApkList_DragLeave" DragOver="ApkList_DragOver" Drop="ApkList_Drop"
                             av:ItemsSource="{av:SampleData ItemCount=5}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <EventSetter Event="PreviewMouseLeftButtonDown"
                                         Handler="ApkItem_PreviewMouseLeftButtonDown" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                        <Border x:Name="selectionBorder" Background="Transparent"
                                                BorderBrush="Transparent" BorderThickness="2"
                                                CornerRadius="8">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="selectionBorder"
                                                        Property="BorderBrush" Value="#FF2A9FFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="cardBorder" Style="{StaticResource ApkCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsEnabled="{Binding SelectionEnabled}"
                                              PreviewMouseLeftButtonDown="ItemCheckBox_PreviewMouseLeftButtonDown" Margin="0,0,10,0" Grid.RowSpan="3" />

                                    <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Width="40" Height="40" CornerRadius="9"
                                            Background="{Binding IconBackground}" VerticalAlignment="Center"
                                            Margin="0,0,12,0"
                                            ToolTipService.ShowDuration="8000">
                                        <Border.ToolTip>
                                            <ToolTip Content="{Binding}"
                                                     ContentTemplate="{StaticResource ApkPathToolTipTemplate}" />
                                        </Border.ToolTip>
                                        <Grid>
                                            <TextBlock Text="{Binding Initial}" Foreground="White"
                                                       FontSize="16" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding NoIcon, Converter={StaticResource BoolToVis}}" />
                                            <Image Source="{Binding Icon}" Stretch="Uniform"
                                                   Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Border>

                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Label}" FontSize="15"
                                               FontWeight="SemiBold" Foreground="#FF000000" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom"
                                               ToolTipService.ShowDuration="8000">
                                        <TextBlock.ToolTip>
                                            <ToolTip Content="{Binding}"
                                                     ContentTemplate="{StaticResource ApkPathToolTipTemplate}" />
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding PackageName}"
                                               FontFamily="Consolas" FontSize="12.5" Foreground="#FF1D4ED8"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Top" ToolTip="{Binding PackageName}" />

                                    <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal"
                                                Margin="0,4,0,0" VerticalAlignment="Center">
                                        <Border Background="#FFDCFCE7" CornerRadius="4" Padding="7,2">
                                            <TextBlock FontSize="12" Foreground="#FF166534">
                                                <Run Text="大小 " />
                                                <Run Text="{Binding SizeText}" />
                                            </TextBlock>
                                        </Border>
                                        <Border x:Name="sdkChip" Background="#FF2563EB" CornerRadius="4" Padding="7,2"
                                                Margin="8,0,0,0">
                                            <TextBlock FontSize="12" Foreground="White">
                                                <Run Text="SDK ≥ " />
                                                <Run Text="{Binding MinSdkText, Mode=OneWay}" />
                                            </TextBlock>
                                        </Border>
                                        <Border x:Name="versionChip" Background="#FF7C3AED" CornerRadius="4" Padding="7,2"
                                                Margin="8,0,0,0" ToolTipService.ShowDuration="8000">
                                            <Border.ToolTip>
                                                <ToolTip Content="{Binding VersionText, Mode=OneWay}" />
                                            </Border.ToolTip>
                                            <TextBlock FontSize="12" Foreground="White" MaxWidth="150"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                                <Run Text="版本 " />
                                                <Run Text="{Binding VersionText, Mode=OneWay}" />
                                            </TextBlock>
                                        </Border>
                                        <Border Background="#FFFEF3C7" CornerRadius="4" Padding="7,2"
                                                Margin="8,0,0,0">
                                            <TextBlock FontSize="12" Foreground="#FF92400E">
                                                <Run Text="解析 " />
                                                <Run Text="{Binding ParseState}" />
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>

                                    <Border x:Name="statusChip" Grid.Row="0" Grid.RowSpan="2" Grid.Column="3"
                                            MinWidth="72" CornerRadius="8" Padding="12,6"
                                            Margin="12,0,0,0" VerticalAlignment="Center"
                                            Background="#FFF1F5F9" BorderBrush="#FFE2E8F0"
                                            BorderThickness="1"
                                            ToolTipService.IsEnabled="{Binding HasDisplayError}"
                                            ToolTipService.ShowDuration="8000">
                                        <Border.ToolTip>
                                            <ToolTip MaxWidth="360">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding SdkErrorText}" MaxWidth="340"
                                                               TextWrapping="Wrap" FontSize="12"
                                                               Foreground="#FFB91C1C"
                                                               Visibility="{Binding SdkIncompatible, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="{Binding ErrorText}" MaxWidth="340"
                                                               TextWrapping="Wrap" FontSize="12"
                                                               Foreground="#FFB91C1C" />
                                                </StackPanel>
                                            </ToolTip>
                                        </Border.ToolTip>
                                        <TextBlock x:Name="statusText" FontSize="14" FontWeight="SemiBold"
                                                   TextAlignment="Center"
                                                   Text="{Binding InstallStateText}"
                                                   Foreground="#FF334155" />
                                    </Border>
                                </Grid>
                            </Border>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding InstallStateText}" Value="未选择">
                                    <Setter TargetName="statusChip" Property="Border.Background" Value="#FFF8FAFC" />
                                    <Setter TargetName="statusChip" Property="Border.BorderBrush" Value="#FFE2E8F0" />
                                    <Setter TargetName="statusText" Property="TextBlock.Foreground" Value="#FF475569" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding InstallStateText}" Value="安装中">
                                    <Setter TargetName="statusChip" Property="Border.Background" Value="#FFFEF3C7" />
                                    <Setter TargetName="statusChip" Property="Border.BorderBrush" Value="#FFFDE68A" />
                                    <Setter TargetName="statusText" Property="TextBlock.Foreground" Value="#FF92400E" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding InstallStateText}" Value="成功">
                                    <Setter TargetName="statusChip" Property="Border.Background" Value="#FFECFDF5" />
                                    <Setter TargetName="statusChip" Property="Border.BorderBrush" Value="#FFA7F3D0" />
                                    <Setter TargetName="statusText" Property="TextBlock.Foreground" Value="#FF047857" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding InstallStateText}" Value="失败">
                                    <Setter TargetName="statusChip" Property="Border.Background" Value="#FFFEE2E2" />
                                    <Setter TargetName="statusChip" Property="Border.BorderBrush" Value="#FFFECACA" />
                                    <Setter TargetName="statusText" Property="TextBlock.Foreground" Value="#FFB91C1C" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding InstallStateText}" Value="跳过">
                                    <Setter TargetName="statusChip" Property="Border.Background" Value="#FFF1F5F9" />
                                    <Setter TargetName="statusChip" Property="Border.BorderBrush" Value="#FFE2E8F0" />
                                    <Setter TargetName="statusText" Property="TextBlock.Foreground" Value="#FF475569" />
                                </DataTrigger>
                                <!-- SDK 不兼容：整体淡红、SDK 徽标变红、状态显示不兼容 -->
                                <DataTrigger Binding="{Binding SdkIncompatible}" Value="True">
                                    <Setter TargetName="cardBorder" Property="Border.Background" Value="#FFFFF7F7" />
                                    <Setter TargetName="cardBorder" Property="Border.BorderBrush" Value="#FFFCA5A5" />
                                    <Setter TargetName="sdkChip" Property="Border.Background" Value="#FFDC2626" />
                                    <Setter TargetName="statusChip" Property="Border.Background" Value="#FFFEE2E2" />
                                    <Setter TargetName="statusChip" Property="Border.BorderBrush" Value="#FFFECACA" />
                                    <Setter TargetName="statusText" Property="TextBlock.Foreground" Value="#FFB91C1C" />
                                    <Setter TargetName="statusText" Property="TextBlock.Text" Value="不兼容" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 空列表提示：无 APK 时显示，引导用户添加或拖放 -->
                    <Border x:Name="emptyHint" Visibility="Collapsed" MinHeight="240"
                            AllowDrop="True"
                            DragEnter="ApkList_DragEnter" DragLeave="ApkList_DragLeave"
                            DragOver="ApkList_DragOver" Drop="ApkList_Drop">
                        <Border Background="#FFF8FAFC" BorderBrush="#FFCBD5E1" BorderThickness="1"
                                CornerRadius="10" Margin="0,0,0,8">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                                <Grid Width="56" Height="56" HorizontalAlignment="Center">
                                    <Border Background="#FFE7F8F1" CornerRadius="14" />
                                    <TextBlock Text="+" FontSize="36" FontWeight="Light"
                                               Foreground="#FF059669" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Margin="0,-4,0,0" />
                                </Grid>
                                <TextBlock Text="暂无 APK 文件" FontSize="16" FontWeight="SemiBold"
                                           Foreground="#FF334155" HorizontalAlignment="Center"
                                           Margin="0,14,0,0" />
                                <TextBlock Text="点击下方「添加」按钮选择 APK，或将 APK 文件拖放到此处"
                                           FontSize="13" Foreground="#FF6B7280"
                                           HorizontalAlignment="Center" TextWrapping="Wrap"
                                           TextAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- 拖放蒙层：半透明深色提示拖放目标 -->
                    <Border x:Name="dropOverlay" Visibility="Collapsed" Background="#A01F293B"
                            CornerRadius="8" IsHitTestVisible="False" />
                    <!-- 拖放提示层：居中的深色提示块，与主界面一致 -->
                    <Border x:Name="dropHintBorder" Visibility="Collapsed" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Background="#E61F293B" CornerRadius="6"
                            Padding="14,6" IsHitTestVisible="False">
                        <TextBlock x:Name="dropHintText" Foreground="White" FontWeight="SemiBold" />
                    </Border>
                </Grid>

                <!-- 安装结果栏：列表下方、按钮上方，仅安装完成后显示，宽度包裹内容 -->
                <Border x:Name="resultBar" Grid.Row="2" Visibility="Collapsed"
                        HorizontalAlignment="Center" Margin="12,8,12,0" Padding="10,8" CornerRadius="8"
                        Background="#FFF0FDF4" BorderBrush="#FFBBF7D0" BorderThickness="1">
                    <TextBlock x:Name="resultText" FontSize="13" TextWrapping="Wrap" />
                </Border>

                <Grid Grid.Row="3" Margin="12,8,12,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 左：选择操作 + 文件操作，细分隔线分组 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="selectAllButton" Content="全选"
                                Style="{StaticResource SelectAllToolButtonStyle}" Click="SelectAll_Click" />
                        <Button x:Name="invertButton" Content="反选"
                                Style="{StaticResource InvertToolButtonStyle}" Click="Invert_Click" />
                        <Rectangle Width="1" Height="18" Fill="#FFE5E7EB" Margin="10,0,4,0"
                                   VerticalAlignment="Center" />
                        <Button x:Name="addButton" Content="添加"
                                Style="{StaticResource AddToolButtonStyle}"
                                ToolTip="选择 APK 文件或文件夹，添加到安装列表"
                                Click="AddButton_Click" />
                        <Button x:Name="removeButton" Content="删除"
                                Style="{StaticResource RemoveToolButtonStyle}"
                                ToolTip="从安装列表中移除当前勾选的 APK"
                                Click="RemoveButton_Click" />
                    </StackPanel>

                    <!-- 中：状态文字，共N项·已选M 合并显示 -->
                    <TextBlock x:Name="summaryText" Grid.Column="1" Margin="12,0" Foreground="#FF6B7280"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />

                    <!-- 右：安装操作 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="startButton" Content="开始安装" Style="{StaticResource StartButtonStyle}"
                                IsEnabled="False" Click="Start_Click" />
                        <Button x:Name="cancelButton" Content="取消" Style="{StaticResource CancelButtonStyle}"
                                Click="Cancel_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>