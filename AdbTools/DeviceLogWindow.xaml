<Window x:Class="AdbTools.DeviceLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="设备日志" Height="720" Width="1024" MinHeight="720" MinWidth="1024"
        WindowStartupLocation="CenterScreen" Background="#FFF3F4F6" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <!-- 标签文字 -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF6B7280"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>

        <!-- 次要按钮：浅灰底，悬停加深 -->
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Padding" Value="11,4"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#FF374151"/>
            <Setter Property="Background" Value="#FFF3F4F6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFE5E7EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFD5D9DF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮：主题蓝 -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF2A9FFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF1E8AE5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF1878C9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 圆角输入框 -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#FF374151"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="White" BorderBrush="#FFD5D9DF"
                                BorderThickness="1" CornerRadius="5" Padding="7,3">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF2A9FFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <!-- 不加 DropShadowEffect：Effect 会把整块内容栅格化，导致卡片里的文字发虚 -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="8"
                BorderBrush="#FFE5E7EB" BorderThickness="1">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="缓冲" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="bufferBox" Width="144" Height="28" Margin="0,0,10,0"
                          IsEditable="False" ToolTipService.ShowDuration="20000"
                          SelectionChanged="Buffer_SelectionChanged"/>

                <TextBlock Text="级别" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="levelBox" Width="144" Height="28" Margin="0,0,10,0"
                          IsEditable="False" ToolTipService.ShowDuration="20000"
                          SelectionChanged="Level_SelectionChanged"/>

                <TextBlock Text="过滤" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="filterBox" Width="180" Height="26" Margin="0,0,10,0"
                         VerticalContentAlignment="Center" Style="{StaticResource SearchBox}"
                         TextChanged="Filter_TextChanged"
                         ToolTip="按关键字过滤（不区分大小写）"/>

                <CheckBox x:Name="autoScrollBox" Content="自动滚动" IsChecked="True"
                          FontSize="13" Foreground="#FF374151"
                          VerticalAlignment="Center" Margin="0,0,8,0"/>

                <Button x:Name="pauseButton" Content="暂停" Style="{StaticResource ToolButton}" Click="Pause_Click"/>
                <Button Content="清空" Style="{StaticResource ToolButton}" Click="Clear_Click"/>
                <Button Content="保存" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                <Button Content="打开目录" Style="{StaticResource ToolButton}" Click="OpenDir_Click"/>
                <Button Content="重连" Style="{StaticResource ToolButton}" Click="Restart_Click"/>
            </WrapPanel>
        </Border>

        <!-- 日志区：深色控制台风格 -->
        <Border Grid.Row="1" Background="#FF1E1E1E" CornerRadius="8" Margin="0,8,0,0"
                BorderBrush="#FF2A2A31" BorderThickness="1" Padding="2">
            <ListBox x:Name="logList"
                     BorderThickness="0" Background="Transparent"
                     SelectionMode="Extended"
                     KeyDown="LogList_KeyDown"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="bd" Background="Transparent" Padding="6,1">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#FF23232A"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#FF2C2C35"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}"
                                   FontFamily="Consolas, Microsoft YaHei, monospace"
                                   FontSize="13" TextWrapping="NoWrap"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- 状态栏 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="6,7,0,0">
            <Ellipse x:Name="statusDot" Width="7" Height="7" Fill="#FF34C38F"
                     VerticalAlignment="Center" Margin="0,1,6,0"/>
            <TextBlock x:Name="statusText" Foreground="#FF6B7280" FontSize="13" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
