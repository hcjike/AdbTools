<Project>
  <!--
    仅在 CI（GitHub Actions 会设置 CI=true）下生效。
    GitHub 的 windows-latest 未安装 .NET Framework 4.6 目标包，改用 NuGet 提供的参考程序集；
    本地构建（未设置 CI）不受影响，仍使用机器上已安装的目标包。
  -->
  <PropertyGroup Condition="'$(CI)' == 'true'">
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
  </PropertyGroup>
  <ItemGroup Condition="'$(CI)' == 'true'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net46" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>
</Project>
