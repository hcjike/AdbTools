<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- M1 验证工具：验证 adb 取流 + H.264 访问单元拆分（后续接入 Media Foundation 解码） -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net46</TargetFramework>
    <RootNamespace>RemoteProbe</RootNamespace>
    <AssemblyName>RemoteProbe</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <EnableDefaultItems>false</EnableDefaultItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 控制台程序 + WPF 窗口：保留命令行统计输出（decode 等），同时可用 ui 参数打开交互窗口 -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="AdbVideoStream.cs" />
    <Compile Include="AccessUnitSplitter.cs" />
    <Compile Include="MfInterfaces.cs" />
    <Compile Include="MfInterop.cs" />
    <Compile Include="H264DecoderMft.cs" />
    <Compile Include="Nv12Converter.cs" />
    <Compile Include="InputInjector.cs" />
    <Compile Include="RemoteControlWindow.cs" />
  </ItemGroup>
</Project>
